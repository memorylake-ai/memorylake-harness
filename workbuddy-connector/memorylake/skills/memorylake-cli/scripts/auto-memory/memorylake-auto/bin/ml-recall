#!/usr/bin/env node
// ml-recall: search MemoryLake and print a short digest. WorkBuddy puts this
// plugin's bin/ on the model's PATH, so the model runs it by name; on Windows
// ml-recall.cmd beside it does the same for a shell that is not Git Bash.
// The work is in ../scripts/lib/recall.mjs. (A file with no extension is
// CommonJS to Node, hence import() rather than an import statement.)
const { pathToFileURL } = require("node:url");
const path = require("node:path");
import(pathToFileURL(path.join(__dirname, "..", "scripts", "lib", "recall.mjs")).href).then(({ recall }) => {
  const result = recall(process.argv.slice(2));
  process.stdout.write(result.stdout);
  process.stderr.write(result.stderr);
  process.exitCode = result.code;
});
