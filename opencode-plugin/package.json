{
  "name": "@memorylake/opencode-plugin",
  "version": "0.1.0",
  "description": "Memory Lake for opencode: cross-device, cross-client long-term memory, including memories written from Claude Code that opencode cannot otherwise see.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "memory",
    "long-term-memory",
    "memorylake"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/memorylake-ai/memorylake-harness.git",
    "directory": "opencode-plugin"
  },
  "homepage": "https://github.com/memorylake-ai/memorylake-harness/tree/main/opencode-plugin",
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.16"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.18",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
